// Cloudflare Workers static assets — 포트폴리오 (portfolio.handykang.com).
// 빌드: pnpm build:cf → out/   (배포는 대시보드 Git 연동에서만, 여기선 설정만)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kang-portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "portfolio.handykang.com", "custom_domain": true },
    // www는 별도 항목: 나중에 다른 Worker로 옮기려면 이 줄만 빼면 됨
    { "pattern": "www.handykang.com", "custom_domain": true }
  ]
  // 나중에 www를 다른 곳으로 돌릴 때 이 파일은 건드리지 않음.
}
